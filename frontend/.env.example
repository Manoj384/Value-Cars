# Value Cars — Frontend Environment Variables
# Copy this file to .env.local (or .env.production) and adjust the values.

# Base URL of the Value Cars backend API (Directus/FastAPI).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Optional. When deployed under a sub-path (e.g. GitHub Pages user site):
# NEXT_PUBLIC_BASE_PATH=/Value-Cars
# Leave unset for a custom domain / Vercel / Docker (app at root).

# --- Telemetry (all optional; local-only queues when unset) ---
# Activity-logging collector (beacon target). When unset, activity events are
# buffered in localStorage only and never sent anywhere.
# NEXT_PUBLIC_EVENTS_URL=https://your-collector.example/events

# Error-logging collector (beacon target). When unset, errors are buffered in
# localStorage only.
# NEXT_PUBLIC_ERRORS_URL=https://your-collector.example/errors

# Optional browser-only Sentry DSN (the Sentry Next SDK does NOT support
# `output: 'export'`; this uses the browser capture API instead).
# NEXT_PUBLIC_SENTRY_DSN=