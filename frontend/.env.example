# Value Cars — Frontend Environment Variables
# Copy this file to .env.local (or .env.production) and adjust the values.

# Base URL of the Value Cars backend API (Directus/FastAPI).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Optional. When deployed under a sub-path (e.g. GitHub Pages user site):
# NEXT_PUBLIC_BASE_PATH=/Value-Cars
# Leave unset for a custom domain / Vercel / Docker (app at root).