# ===============================================
# VALUE CARS - BACKEND ENVIRONMENT CONFIGURATION
# ===============================================

PROJECT_NAME="Value Cars API"
VERSION="1.0.0"
ENVIRONMENT="production"

# --- SUPABASE POSTGRESQL DATABASE URL ---
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooler)
# Format for SQLAlchemy asyncpg:
# postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Or Direct:
# postgresql+asyncpg://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- SECURITY ---
SECRET_KEY=your-super-secret-jwt-key-for-value-cars-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AUDIT FIX F: ADMIN BOOTSTRAP PASSWORD ---
# Used ONLY when seeding the initial admin account. In production, set this to a
# strong, unique value ONCE to create the first admin, then REMOVE it (or rotate)
# so the seed service never auto-(re)creates admin accounts. Leave empty to skip
# auto-creation of admin accounts in production entirely.
ADMIN_BOOTSTRAP_PASSWORD=

# --- AUDIT FIX B: DEV-ONLY OTP STUB ---
# KEEP OFF in production. The send-otp / verify-otp debug endpoints return 410
# when false. Enable ONLY in local/dev environments.
OTP_DEV_MODE=false

# --- CORS ORIGINS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://your-frontend.vercel.app