# Value Cars — Backend Environment Variables
# Copy this file to .env and adjust the values for your environment.

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
SECRET_KEY=                      # REQUIRED in production — use `openssl rand -base64 48`
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./value_cars.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/valuecars_db

# ── Frontend URL (for CORS + links) ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── CORS — Comma-separated origins ──────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://manoj384.github.io"]

# ── Notifications & Automated WhatsApp / SMS Delivery ────────────────────────
NOTIFICATIONS_ENABLED=true

# Provider options: "mock" (default, logs to console) | "twilio" | "meta"
WHATSAPP_PROVIDER=mock

# Twilio Configuration (Option 1)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=+14155238886

# Meta WhatsApp Cloud API Configuration (Option 2)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# SMS Provider options: "mock" | "twilio" | "fast2sms"
SMS_PROVIDER=mock
FAST2SMS_API_KEY=

# Admin Notification Recipients
ADMIN_ALERT_PHONE=+918050966025
ADMIN_SECONDARY_PHONE=+918310166040
ADMIN_PRIVATE_PHONE=+916362923891