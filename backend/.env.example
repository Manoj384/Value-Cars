# Value Cars — Backend Environment Variables
# Copy this file to .env and adjust the values for your environment.

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
SECRET_KEY=                      # REQUIRED in production — use `openssl rand -base64 48`
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./value_cars.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/valuecars_db

# ── Frontend URL (for CORS + links) ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── CORS — Comma-separated origins ──────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]